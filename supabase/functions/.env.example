# Supabase Edge Function secrets (auth-send-email hook).
# Copy to supabase/functions/.env and run:
#   supabase secrets set --env-file supabase/functions/.env --project-ref YOUR_PROJECT_REF
#
# Never commit real keys.

RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Waka POS <noreply@waka.ug>"
EMAIL_REPLY_TO=support@waka.ug
SEND_EMAIL_HOOK_SECRET=v1,whsec_your_hook_secret_from_supabase_dashboard
# Optional: set to false to skip the welcome email after signup verification
SEND_WELCOME_ON_SIGNUP=true

# --- Google Wallet loyalty passes (Phase 5) — optional until issuer is ready ---
# Create issuer in Google Pay & Wallet Console; service account needs walletobjects.issuer.
# GOOGLE_WALLET_ISSUER_ID=3388000000000000001
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# WALLET_ALLOWED_ORIGINS=https://pos.waka.ug
# GOOGLE_WALLET_LOGO_URL=https://pos.waka.ug/waka-logo.png
# WALLET_PUBLIC_APP_URL=https://pos.waka.ug
#
# Deploy:
#   supabase functions deploy loyalty-wallet-pass --project-ref YOUR_PROJECT_REF
#   supabase functions deploy loyalty-wallet-sync --project-ref YOUR_PROJECT_REF
