# WAKA POS — RS-4D lab environment (Windows Electron process only)
# Copy to C:\WAKA\remote-support-lab\waka-lab.env or scripts/lab/remote-support-lab.env
# Do not commit filled values. Do not put these in Vite .env files or any VITE_* key.
# Do not set these on a production POS. Default transport remains off.
# Slice A: ID server, relay, and public key belong in this process env only.

# Required. Anything other than lab is treated as off.
WAKA_REMOTE_SUPPORT_TRANSPORT=lab

# Required. Absolute allowlist root. No "..".
WAKA_REMOTE_SUPPORT_LAB_DIR=C:\WAKA\remote-support-lab

# Recommended. Must be a file named rustdesk.exe or rustdesk INSIDE the lab dir.
WAKA_RUSTDESK_EXECUTABLE_PATH=C:\WAKA\remote-support-lab\rustdesk.exe

# Required. Isolated hbbs host. Public rustdesk.com hosts are rejected.
WAKA_RUSTDESK_ID_SERVER=REPLACE_WITH_ISOLATED_HBBS_HOST

# Isolated hbbr host. If omitted, WAKA copies the ID server. Must not be public.
WAKA_RUSTDESK_RELAY_SERVER=REPLACE_WITH_ISOLATED_HBBR_HOST

# Required. Isolated server PUBLIC key (length >= 16). Never the private key.
WAKA_RUSTDESK_KEY=REPLACE_WITH_ISOLATED_SERVER_PUBLIC_KEY
