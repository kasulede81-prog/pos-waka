# Vite mode: development (`npm run dev`)
# Copy to `.env.development.local` (gitignored).

VITE_SUPABASE_URL=https://YOUR_DEV_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_dev_anon_key
VITE_APP_URL=http://localhost:5173
# VITE_APP_NAME=Waka POS (Dev)
# VITE_APP_SHORT_NAME=WakaPOS

# Optional: show Ollama in Internal Admin (local/dev only). Never set on production.
# Ignored when VITE_SUPABASE_URL points at the production project.
# VITE_ALLOW_OLLAMA_PROVIDER=true
